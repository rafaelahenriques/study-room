# Copy to .env.local and fill in. Everything is optional: without it the room
# runs on the manual control panel and a default location.

# Location used for live weather (Open-Meteo, no key needed)
VITE_WEATHER_LAT=38.72
VITE_WEATHER_LON=-9.14

# MQTT broker (secure WebSocket) for the ESP32 sensors.
# Use a SUBSCRIBE-ONLY user here: these values are visible in the browser.
VITE_MQTT_URL=
VITE_MQTT_USER=
VITE_MQTT_PASS=

